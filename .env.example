# ========================================================
# MIT WELL TECH INSTITUTE - Environment Configuration
# ========================================================

# Firebase Web App Credentials (obtain from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=mit-welltech-verification.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mit-welltech-verification
VITE_FIREBASE_STORAGE_BUCKET=mit-welltech-verification.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Public URL used in generated QR Codes (leave empty or set for Vercel production domain)
# Example: https://mitwelltech.vercel.app
VITE_APP_URL=
